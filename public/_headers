# Cloudflare Pages response headers — https://developers.cloudflare.com/pages/configuration/headers/
# Copied to out/_headers by `npm run build`.
#
# NOTE: if two rules set the same header for a URL, Cloudflare joins the values with a comma.
# So Cache-Control is only set on the specific paths below, never on /*.
# HTML pages keep Cloudflare's default (always revalidated), so new deploys show up immediately.

# Security headers for every response
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# Next.js build assets have content hashes in their names → cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Site images → cache for 1 year.
# When you REPLACE an image, give the new file a new name (e.g. house-2.webp) and update
# site.json, so visitors don't keep seeing the old cached version.
/images/*
  Cache-Control: public, max-age=31536000

# Favicon & metadata files → cache for 1 day.
/favicon.ico
  Cache-Control: public, max-age=86400
/manifest.webmanifest
  Cache-Control: public, max-age=86400
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
